# To be used in conjunction with estyle. These settings make the plots suitable for the jupyter notebook enivronment (everyday use)

# Title settings ---------------------------------------------------------------
axes.titlepad : 15 # Changes the size of the pad between the plot and the title

# Font settings -----------------------------------------
font.size : 15
legend.fontsize : 15
axes.labelsize : 15
xtick.labelsize : 12  # Font size for x-axis tick labels
ytick.labelsize : 12  # Font size for y-axis tick labels

# Plotting settings-------------------------------------
# Marker size settings
lines.markersize : 7.5  # Set the default marker size
# Line settings
lines.linewidth : 3

# Line settings-----------------------------------------------------------------------
axes.linewidth : 1.5  # Linewidth of the border around the plot (axes spines)
xtick.major.width : 1.5  # Linewidth of the major tick marks on the x-axis
ytick.major.width : 1.5  # Linewidth of the major tick marks on the y-axis
xtick.minor.width : 0.75  # Linewidth of the minor tick marks on the x-axis (if used)
ytick.minor.width : 0.75  # Linewidth of the minor tick marks on the y-axis (if used)

# Ticks--------------------------------------------------------
# Major tick size settings
xtick.major.size : 9  # Length of x-axis major ticks in points
ytick.major.size : 9  # Length of y-axis major ticks in points
# Minor tick size settings
xtick.minor.size : 4  # Length of x-axis minor ticks in points
ytick.minor.size : 4  # Length of y-axis minor ticks in points