# To be used in conjunction with estyle. Makes the plots suitable for presentations


# Figure settings---------------------------------------------------------------------------------------------------
figure.figsize : 16, 9  # Width and height in inches
figure.dpi : 300

# Font settings-----------------------------------------------------------------------------------------------------
font.size : 30
legend.fontsize : 30
axes.labelsize : 30
xtick.labelsize : 24  # Font size for x-axis tick labels
ytick.labelsize : 24  # Font size for y-axis tick labels

# Plotting settings------------------------------------------------------------------------------------------------
# Marker size settings
lines.markersize : 15  # Set the default marker size
# Line settings
lines.linewidth : 6

# Axes settings-----------------------------------------------------------------------------------------------------
# Reduce the space around the axes
# axes.xmargin : 0  # Removes horizontal margins
axes.ymargin : 0  # Removes vertical margins

# Line settings-----------------------------------------------------------------------------------------------------
axes.linewidth : 2.5  # Linewidth of the border around the plot (axes spines)
xtick.major.width : 2.5  # Linewidth of the major tick marks on the x-axis
ytick.major.width : 2.5  # Linewidth of the major tick marks on the y-axis
xtick.minor.width : 1.5  # Linewidth of the minor tick marks on the x-axis (if used)
ytick.minor.width : 1.5  # Linewidth of the minor tick marks on the y-axis (if used)

# Ticks--------------------------------------------------------------------------------------------------------------
# Major tick size settings
xtick.major.size : 18  # Length of x-axis major ticks in points
ytick.major.size : 18  # Length of y-axis major ticks in points
# Minor tick size settings
xtick.minor.size : 12  # Length of x-axis minor ticks in points
ytick.minor.size : 12  # Length of y-axis minor ticks in points