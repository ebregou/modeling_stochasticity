# Sets global properties of all plotting (whether for notebooks or for presentations

# Colors
axes.prop_cycle : cycler('color', ['b84557ff', '03abc1ff', 'd4d000', '111114']) # Don't include the hashtag in the hexadecimal

# Fonts---------------
font.family: STIX Two Text
mathtext.fontset: stix

# Ticks-------------------------------
# Tick direction settings
xtick.direction : in
ytick.direction : in
# Enable ticks on all four sides
xtick.top : True
ytick.right : True